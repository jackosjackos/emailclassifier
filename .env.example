# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# --- Required: Azure AD app registration (client-credentials flow) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Required: the shared mailbox to poll ---
MAILBOX_USER_ID=support@yourcompany.com

# --- Optional tuning ---
INTERNAL_DOMAIN=yourcompany.com
KNOWN_CLIENT_DOMAINS=clienta.com,clientb.com
HIGH_CONFIDENCE_THRESHOLD=25
LOW_CONFIDENCE_THRESHOLD=-25

# --- Test run controls ---
# TEST_MODE=true fetches a fixed sample of the most recent emails instead
# of using delta query (which otherwise only shows new/changed messages).
TEST_MODE=false
TEST_SAMPLE_SIZE=100

# DRY_RUN=true computes scores/decisions and writes the report, but never
# applies categories to your mailbox. Defaults to true automatically
# whenever TEST_MODE=true — only set this explicitly if you want to
# override that default.
# DRY_RUN=true

# Set to false to stop the report auto-opening in your browser after each run.
OPEN_REPORT=true

# Only used by `npm run watch` — standard cron syntax, local time.
WATCH_CRON=*/15 * * * *

# --- PST import mode (offline, no Graph/Azure credentials needed) ---
# Path to a .pst file exported from Outlook. Can also be passed as a CLI
# arg instead: node scripts/import-pst.js path/to/file.pst
PST_FILE_PATH=
# How many of the most recent messages to score.
PST_SAMPLE_SIZE=100
# Which folder in the PST to read, by display name. Change this if your
# export used a different folder name or a non-English Outlook locale.
PST_FOLDER_NAME=Inbox
